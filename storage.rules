rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /marketplace/products/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == "KSXJJqnu3FhuFcTye2lRlxxct6r2";
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
